# ESP-IDF build output
build/

# Per-machine generated config (sdkconfig.defaults is committed instead)
sdkconfig
sdkconfig.old

# Fetched vendor code, re-derivable from dependencies.lock
managed_components/

# dependencies.lock is deliberately NOT ignored. idf_component.yml holds version
# *ranges*, so it cannot pin a build on its own — the lock is the only record of
# what was actually compiled, including a content hash per component. Without it
# a clean clone re-resolves against the registry and can silently take different
# versions, most notably lvgl, which esp_lvgl_port requests as >=8,<10.
