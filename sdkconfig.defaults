# The Knomi V1 module carries 16 MB of flash. Without this the build defaults to
# 2 MB and the bootloader warns that the detected size exceeds the image header.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# 1 kHz tick keeps vTaskDelay granularity at 1 ms, which the display timing wants.
CONFIG_FREERTOS_HZ=1000
